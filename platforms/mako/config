# Jylhis Mako — hand-maintained light-mode copy of config-light; refresh on variant renames.
# ~/.config/mako/config
# Notifications with the command-palette language: accent left-border,
# monospace meta, sheet/field bg. Dismiss hint always visible.

font=IBM Plex Mono 11
width=380
height=120
margin=12
padding=14,16
border-size=1
border-radius=4
max-icon-size=32
icon-path=/usr/share/icons/Adwaita

# Default — sheet
background-color=#e9ebef
text-color=#2a2d33
border-color=#abb0b8
progress-color=over #582d00

# Layout / animation
layer=overlay
anchor=top-right
default-timeout=6000
ignore-timeout=0

format=<b>%s</b>\n%b\n<span foreground='#8b8f96' font='IBM Plex Mono 9'>esc to dismiss · meta+n to focus</span>

# Selected marker — matches KEYBOARD.md §"Selected item (universal)"
[focused]
background-color=#fbfdff
border-color=#582d00
# Mako can't draw a left-border only, but border + color does the job.

# Urgency levels — map to semantic family
[urgency=low]
border-color=#8b8f96

[urgency=normal]
border-color=#abb0b8

[urgency=critical]
background-color=#f5e0dc
text-color=#a40000
border-color=#a40000          # Modus red (status-err)
default-timeout=0

# Specific app rules
[app-name=Emacs]
border-color=#5317ac          # Modus magenta-cooler (syn-keyword)

[category=mpd]
border-color=#056a04          # Modus green (status-ok)
