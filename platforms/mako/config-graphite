# Jylhis Mako — GENERATED from tokens.json. Do not edit by hand.
# ~/.config/mako/config
# Notifications with the command-palette language: accent left-border,
# monospace meta, Sheet/Field bg. Dismiss hint always visible.

font=IBM Plex Mono 11
width=380
height=120
margin=12
padding=14,16
border-size=1
border-radius=4
max-icon-size=32
icon-path=/usr/share/icons/Adwaita

# Default — graphite
background-color=#1f1f1f
text-color=#dadada
border-color=#4a4a4a
progress-color=over #ffffff

# Layout / animation
layer=overlay
anchor=top-right
default-timeout=6000
ignore-timeout=0

format=<b>%s</b>\n%b\n<span foreground='#6a6a6a' font='IBM Plex Mono 9'>esc to dismiss · meta+n to focus</span>

# Selected marker — matches KEYBOARD.md §"Selected item (universal)"
[focused]
background-color=#282828
border-color=#ffffff
# Mako can't draw a left-border only, but border + color does the job.

# Urgency levels — map to semantic family
[urgency=low]
border-color=#6a6a6a

[urgency=normal]
border-color=#4a4a4a

[urgency=critical]
background-color=#282828
text-color=#f0f0f0
border-color=#f0f0f0          # status-err
default-timeout=0

# Specific app rules
[app-name=Emacs]
border-color=#ededed          # Modus magenta-cooler (syn-keyword)

[category=mpd]
border-color=#909090          # Modus green (status-ok)
