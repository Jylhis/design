# Jylhis Mako — GENERATED from tokens.json. Do not edit by hand.
# ~/.config/mako/config
# Notifications with the command-palette language: accent left-border,
# monospace meta, paper/roast bg. Dismiss hint always visible.

font=JetBrains Mono 11
width=380
height=120
margin=12
padding=14,16
border-size=1
border-radius=4
max-icon-size=32
icon-path=/usr/share/icons/Adwaita

# Default — paper
background-color=#e8e1d6
text-color=#2c2825
border-color=#b0a898
progress-color=over #9a5a2a

# Layout / animation
layer=overlay
anchor=top-right
default-timeout=6000
ignore-timeout=0

format=<b>%s</b>\n%b\n<span foreground='#8a7f72' font='JetBrains Mono 9'>esc to dismiss · meta+n to focus</span>

# Selected marker — matches KEYBOARD.md §"Selected item (universal)"
[focused]
background-color=#fefdfb
border-color=#9a5a2a
# Mako can't draw a left-border only, but border + color does the job.

# Urgency levels — map to semantic family
[urgency=low]
border-color=#8a7f72

[urgency=normal]
border-color=#b0a898

[urgency=critical]
background-color=#f5e0dc
text-color=#a60000
border-color=#a60000          # Modus red (status-err)
default-timeout=0

# Specific app rules
[app-name=Emacs]
border-color=#4a2d80          # Modus magenta-cooler (syn-keyword)

[category=mpd]
border-color=#006800          # Modus green (status-ok)
