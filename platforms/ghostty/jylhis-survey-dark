# Jylhis Survey Dark (dark) — Ghostty colorscheme
# Drop in ~/.config/ghostty/themes/jylhis-survey-dark and reference with
# `theme = jylhis-survey-dark` in config.
#
# ANSI 0–6 are Modus Vivendi accents so `ls`, `bat`, `delta`, `git log`
# share the editor's palette. ANSI 11 is the brand bronze — intentional
# override so prompts and dir-permissions carry the Jylhis identity.
# See tokens.md §3.

palette = 0=#0d0f14
palette = 1=#f0685f
palette = 2=#6bbf6b
palette = 3=#d9b34a
palette = 4=#5fb8cf
palette = 5=#feacd0
palette = 6=#5fb8cf
palette = 7=#d6dae2
palette = 8=#656b76
palette = 9=#ff7f7f
palette = 10=#70b900
palette = 11=#e0a33a
palette = 12=#6f9be0
palette = 13=#b6a0ff
palette = 14=#00d3d0
palette = 15=#f2f4f8

background         = #0d0f14
foreground         = #d6dae2
