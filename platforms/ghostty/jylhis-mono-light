# Jylhis Monochrome Light (light) — Ghostty colorscheme
# Drop in ~/.config/ghostty/themes/jylhis-mono-light and reference with
# `theme = jylhis-mono-light` in config.
#
# ANSI 0–6 are Modus Operandi accents so `ls`, `bat`, `delta`, `git log`
# share the editor's palette. ANSI 11 is the brand bronze — intentional
# override so prompts and dir-permissions carry the Jylhis identity.
# See tokens.md §3.

palette = 0=#212121
palette = 1=#a60000
palette = 2=#006800
palette = 3=#8a5000
palette = 4=#005e8b
palette = 5=#1c1c1c
palette = 6=#005e8b
palette = 7=#545454
palette = 8=#828282
palette = 9=#972500
palette = 10=#315b00
palette = 11=#000000
palette = 12=#4a4a4a
palette = 13=#5317ac
palette = 14=#2b2b2b
palette = 15=#212121

background         = #f7f7f7
foreground         = #212121
cursor-color       = #3d3d3d
cursor-text        = #f7f7f7
selection-background = #dfe6f2
selection-foreground = #212121
