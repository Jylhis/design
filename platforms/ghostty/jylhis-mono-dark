palette = 6=#5fb8cf
palette = 7=#d9d9d9
palette = 8=#6e6e6e
palette = 9=#ff7f7f
palette = 10=#70b900
palette = 11=#e6e6e6
palette = 12=#8f8f8f
palette = 13=#f0f0f0
palette = 14=#5fb8cf
palette = 15=#f5f5f5

