# Jylhis Graphite (mono-dark) — Ghostty colorscheme
# Drop in ~/.config/ghostty/themes/jylhis-graphite and reference with
# `theme = jylhis-graphite` in config.
#
# ANSI 0–6 are graded grays so `ls`, `bat`, `delta`, `git log`
# share the editor's palette. ANSI 11 is the ink accent (black/white) — intentional
# override so prompts and dir-permissions carry the Jylhis identity.
# See tokens.md §3.

palette = 0=#0d0d0d
palette = 1=#f0f0f0
palette = 2=#909090
palette = 3=#b8b8b8
palette = 4=#d0d0d0
palette = 5=#c8c8c8
palette = 6=#b0b0b0
palette = 7=#9a9a9a
palette = 8=#6a6a6a
palette = 9=#ffffff
palette = 10=#a5a5a5
palette = 11=#ffffff
palette = 12=#dcdcdc
palette = 13=#d5d5d5
palette = 14=#c0c0c0
palette = 15=#f2f2f2

background         = #0d0d0d
foreground         = #dadada
cursor-color       = #ffffff
cursor-text        = #0d0d0d
selection-background = #3a3a3a
selection-foreground = #dadada
