# Jylhis Chalk (mono-light) — Ghostty colorscheme
# Drop in ~/.config/ghostty/themes/jylhis-chalk and reference with
# `theme = jylhis-chalk` in config.
#
# ANSI 0–6 are graded grays so `ls`, `bat`, `delta`, `git log`
# share the editor's palette. ANSI 11 is the ink accent (black/white) — intentional
# override so prompts and dir-permissions carry the Jylhis identity.
# See tokens.md §3.

palette = 0=#242424
palette = 1=#1f1f1f
palette = 2=#565656
palette = 3=#454545
palette = 4=#333333
palette = 5=#3a3a3a
palette = 6=#4a4a4a
palette = 7=#565656
palette = 8=#7d7d7d
palette = 9=#2a2a2a
palette = 10=#6a6a6a
palette = 11=#000000
palette = 12=#404040
palette = 13=#4a4a4a
palette = 14=#555555
palette = 15=#1a1a1a

background         = #f4f4f4
foreground         = #2b2b2b
cursor-color       = #000000
cursor-text        = #f4f4f4
selection-background = #c8c8c8
selection-foreground = #2b2b2b
