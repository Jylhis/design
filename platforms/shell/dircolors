# Jylhis LS_COLORS
# Maps filetypes to the Modus-flavoured ANSI 16-color brand palette.
# See tokens.md §3 — ANSI 0–6 are Modus accents, 11 is the the bronze accent.
# Generate with: dircolors -b platforms/shell/dircolors > ~/.dir_colors
# Then in bash/zsh:  eval "$(dircolors -b ~/.dir_colors)"

# Term entries — apply to any 256-color or truecolor terminal.
TERM *

# Reset
RESET 0

# File types — ANSI slot number maps to tokens.md §3
NORMAL 00
FILE 00
DIR 01;34           # Modus blue — tag / info
LINK 00;36          # Modus cyan-cooler — type
MULTIHARDLINK 00
FIFO 40;33          # amber on bg-subtle
SOCK 01;35          # plum
DOOR 01;35
BLK 40;33;01
CHR 40;33;01
ORPHAN 40;31;01     # broken link = error red
MISSING 00
SETUID 37;41
SETGID 30;43
CAPABILITY 30;41
STICKY_OTHER_WRITABLE 30;42
OTHER_WRITABLE 34;42
STICKY 37;44
EXEC 01;32          # bold olive

# Archives — plum family
.tar    00;35
.tgz    00;35
.zip    00;35
.gz     00;35
.bz2    00;35
.xz     00;35
.zst    00;35
.7z     00;35
.rar    00;35

