<?xml version="1.0" encoding="UTF-8"?>
<!--
  Jylhis Kvantum theme colors — GENERATED from tokens.json. Do not edit by hand.
  ~/.config/Kvantum/JylhisPaper.colors

  Kvantum's .kvconfig controls geometry; .colors is the palette.
  Pair this with a base theme like KvGnomeDark or KvAdapta and only the
  palette will be re-tinted.

  Apply:
    kvantummanager --set JylhisPaper
    qt5ct / qt6ct → Appearance → "kvantum" / "kvantum-dark"
-->

<!-- JylhisPaper.colors  (light) -->
<palette theme="JylhisPaper">
  <color role="Window">#faf7f2</color>
  <color role="WindowText">#2c2825</color>
  <color role="Base">#fefdfb</color>
  <color role="AlternateBase">#f0ebe3</color>
  <color role="Text">#2c2825</color>
  <color role="BrightText">#1e1b18</color>
  <color role="Button">#e8e1d6</color>
  <color role="ButtonText">#2c2825</color>
  <color role="Highlight">#9a5a2a</color>
  <color role="HighlightedText">#faf7f2</color>
  <color role="Link">#9a5a2a</color>
  <color role="LinkVisited">#1f4d8a</color><!-- Modus blue-warmer -->

  <color role="ToolTipBase">#fefdfb</color>
  <color role="ToolTipText">#2c2825</color>
  <color role="Light">#fefdfb</color>
  <color role="Midlight">#f0ebe3</color>
  <color role="Mid">#d5cec4</color>
  <color role="Dark">#6b5f54</color>
  <color role="Shadow">#2c2825</color>

  <!-- Disabled group -->
  <color role="WindowText" group="Disabled">#8a7f72</color>
  <color role="Text"        group="Disabled">#8a7f72</color>
  <color role="ButtonText"  group="Disabled">#8a7f72</color>

  <!-- Inactive (unfocused) — same color, matches flat paper metaphor -->
  <color role="Highlight"        group="Inactive">#b0a898</color>
  <color role="HighlightedText"  group="Inactive">#2c2825</color>
</palette>
