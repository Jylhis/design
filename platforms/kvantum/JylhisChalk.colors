<?xml version="1.0" encoding="UTF-8"?>
<!--
  Jylhis Kvantum theme colors — GENERATED from tokens.json. Do not edit by hand.
  ~/.config/Kvantum/JylhisChalk.colors

  Kvantum's .kvconfig controls geometry; .colors is the palette.
  Pair this with a base theme like KvGnomeDark or KvAdapta and only the
  palette will be re-tinted.

  Apply:
    kvantummanager --set JylhisChalk
    qt5ct / qt6ct → Appearance → "kvantum" / "kvantum-dark"
-->

<!-- JylhisChalk.colors  (mono-light) -->
<palette theme="JylhisChalk">
  <color role="Window">#f4f4f4</color>
  <color role="WindowText">#2b2b2b</color>
  <color role="Base">#fcfcfc</color>
  <color role="AlternateBase">#ececec</color>
  <color role="Text">#2b2b2b</color>
  <color role="BrightText">#1a1a1a</color>
  <color role="Button">#e2e2e2</color>
  <color role="ButtonText">#2b2b2b</color>
  <color role="Highlight">#000000</color>
  <color role="HighlightedText">#f4f4f4</color>
  <color role="Link">#000000</color>
  <color role="LinkVisited">#474747</color><!-- Modus blue-warmer -->

  <color role="ToolTipBase">#fcfcfc</color>
  <color role="ToolTipText">#2b2b2b</color>
  <color role="Light">#fcfcfc</color>
  <color role="Midlight">#ececec</color>
  <color role="Mid">#cfcfcf</color>
  <color role="Dark">#565656</color>
  <color role="Shadow">#2b2b2b</color>

  <!-- Disabled group -->
  <color role="WindowText" group="Disabled">#7d7d7d</color>
  <color role="Text"        group="Disabled">#7d7d7d</color>
  <color role="ButtonText"  group="Disabled">#7d7d7d</color>

  <!-- Inactive (unfocused) — same color, matches the flat survey-sheet metaphor -->
  <color role="Highlight"        group="Inactive">#b0b0b0</color>
  <color role="HighlightedText"  group="Inactive">#2b2b2b</color>
</palette>
