{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#2b2b2b",
    "margin": 2
  },
  "block_quote": {
    "color": "#565656",
    "italic": true,
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#1a1a1a",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#f4f4f4",
    "background_color": "#000000",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#1a1a1a",
    "bold": true
  },
  "h3": {
    "prefix": "### ",
    "color": "#1a1a1a",
    "bold": true
  },
  "h4": {
    "prefix": "#### ",
    "color": "#565656",
    "bold": true
  },
  "h5": {
    "prefix": "##### ",
    "color": "#565656"
  },
  "h6": {
    "prefix": "###### ",
    "color": "#7d7d7d"
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#cfcfcf",
    "format": "\n──────────\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#000000",
    "underline": true
  },
  "link_text": {
    "color": "#000000",
    "bold": true
  },
  "image": {
    "color": "#4a4a4a",
    "underline": true
  },
  "image_text": {
    "color": "#565656",
    "format": "image: {{.text}}"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#2b2b2b",
    "background_color": "#ececec"
  },
  "code_block": {
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#2b2b2b"
      },
      "error": {
        "color": "#1f1f1f"
      },
      "comment": {
        "color": "#5a5a5a",
        "italic": true
      },
      "comment_preproc": {
        "color": "#1c1c1c"
      },
      "keyword": {
        "color": "#1c1c1c"
      },
      "keyword_reserved": {
        "color": "#1c1c1c"
      },
      "keyword_namespace": {
        "color": "#1c1c1c"
      },
      "keyword_type": {
        "color": "#2e2e2e"
      },
      "operator": {
        "color": "#1c1c1c"
      },
      "punctuation": {
        "color": "#2b2b2b"
      },
      "name": {
        "color": "#333333"
      },
      "name_builtin": {
        "color": "#424242"
      },
      "name_tag": {
        "color": "#2e2e2e"
      },
      "name_attribute": {
        "color": "#262626"
      },
      "name_class": {
        "color": "#2e2e2e"
      },
      "name_constant": {
        "color": "#474747"
      },
      "name_decorator": {
        "color": "#424242"
      },
      "name_exception": {
        "color": "#1f1f1f"
      },
      "name_function": {
        "color": "#262626"
      },
      "name_other": {
        "color": "#333333"
      },
      "literal": {
        "color": "#3d3d3d"
      },
      "literal_number": {
        "color": "#474747"
      },
      "literal_date": {
        "color": "#3d3d3d"
      },
      "literal_string": {
        "color": "#3d3d3d"
      },
      "literal_string_escape": {
        "color": "#424242"
      },
      "generic_deleted": {
        "color": "#1f1f1f"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#565656"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#1c1c1c"
      },
      "background": {
        "background_color": "#ececec"
      }
    }
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─",
    "color": "#2b2b2b"
  },
  "definition_term": {
    "color": "#1a1a1a",
    "bold": true
  },
  "definition_description": {
    "block_prefix": "\n  ",
    "color": "#2b2b2b"
  },
  "html_block": {
    "color": "#7d7d7d"
  },
  "html_span": {
    "color": "#7d7d7d"
  }
}
