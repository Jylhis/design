# Jylhis Mako — GENERATED from tokens.json. Do not edit by hand.
# ~/.config/mako/config
# Notifications with the command-palette language: accent left-border,
# monospace meta, sheet/field bg. Dismiss hint always visible.

font=IBM Plex Mono 11
width=380
height=120
margin=12
padding=14,16
border-size=1
border-radius=4
max-icon-size=32
icon-path=/usr/share/icons/Adwaita

# Default — field
background-color=#1c1f24
text-color=#d1d4dc
border-color=#3f4754
progress-color=over #f5a351

# Layout / animation
layer=overlay
anchor=top-right
default-timeout=6000
ignore-timeout=0

format=<b>%s</b>\n%b\n<span foreground='#8b8f96' font='IBM Plex Mono 9'>esc to dismiss · meta+n to focus</span>

# Selected marker — matches KEYBOARD.md §"Selected item (universal)"
[focused]
background-color=#262a2f
border-color=#f5a351
# Mako can't draw a left-border only, but border + color does the job.

# Urgency levels — map to semantic family
[urgency=low]
border-color=#8b8f96

[urgency=normal]
border-color=#3f4754

[urgency=critical]
background-color=#3a1f1c
text-color=#ff8271
border-color=#ff8271          # Modus red (status-err)
default-timeout=0

# Specific app rules
[app-name=Emacs]
border-color=#b4a8ff          # Modus magenta-cooler (syn-keyword)

[category=mpd]
border-color=#39ae34          # Modus green (status-ok)
