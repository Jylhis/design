{
  "meta": {
    "name": "Jylhis",
    "slug": "jylhis",
    "blurb": "one theme, two modes — cool sheet grounds, bronze accent, vermilion maker's mark, contour-blue linework; structure from the monochrome skeleton",
    "modes": {
      "light": "Print — ink on paper",
      "dark": "Negative — the developed plate"
    }
  },
  "palette": {
    "bg": {
      "light": "#f5f8fc",
      "dark": "#0c0f14",
      "ansi": "unspecified-bg",
      "notes": "cool near-white / near-black, never pure; 16-color TTY inherits terminal bg"
    },
    "bg-subtle": {
      "light": "#eff2f6",
      "dark": "#14171c",
      "x256": {
        "light": "color-253",
        "dark": "color-235"
      },
      "notes": "code fills, zebra, inactive modeline"
    },
    "surface": {
      "light": "#e9ebef",
      "dark": "#1c1f24",
      "x256": {
        "light": "color-251",
        "dark": "color-237"
      },
      "notes": "card / panel fill"
    },
    "surface-raised": {
      "light": "#fbfdff",
      "dark": "#262a2f",
      "x256": {
        "dark": "color-239"
      },
      "notes": "plates, modals, dropdowns"
    },
    "text": {
      "light": "#2a2d33",
      "dark": "#d1d4dc",
      "ansi": "unspecified-fg",
      "notes": "body (AAA)"
    },
    "text-muted": {
      "light": "#60646b",
      "dark": "#878b91",
      "notes": "meta / captions / help (AA)"
    },
    "text-heading": {
      "light": "#191c22",
      "dark": "#e7ebf2",
      "notes": "titles (AAA)"
    },
    "text-faint": {
      "light": "#8b8f96",
      "dark": "#5d6067",
      "notes": "decoration only"
    },
    "accent": {
      "light": "#693900",
      "dark": "#f5a351",
      "ansi": "bright-yellow",
      "notes": "bronze interactive accent (AAA); ANSI 11 is always the accent"
    },
    "accent-hover": {
      "light": "#582d00",
      "dark": "#ffb063",
      "notes": ":hover / :active only"
    },
    "brand": {
      "light": "#a63800",
      "dark": "#f8763a",
      "notes": "benchmark vermilion — maker's mark and datum triangle; distinct from status red"
    },
    "contour": {
      "light": "#2b4aaa",
      "dark": "#7ca2ff",
      "notes": "structural Modus-blue linework; never interaction"
    },
    "border": {
      "light": "#d2d8e0",
      "dark": "#242c37",
      "notes": "default 1px hairline"
    },
    "border-strong": {
      "light": "#abb0b8",
      "dark": "#3f4754",
      "notes": "table heads, field hover"
    },
    "decorator": {
      "light": "#8f97aa",
      "dark": "#525a6b",
      "notes": "graticule / dashed rules"
    },
    "accent-subtle": {
      "light": "#fbebdd",
      "dark": "#281604",
      "notes": "solid tint = accent ramp step 1; bronze wash for callouts, selected rows"
    },
    "selection-bg": {
      "light": "#edd8c5",
      "dark": "#3c2206",
      "notes": "text selection (bronze-tinted)"
    },
    "cursor": {
      "light": "#693900",
      "dark": "#f5a351",
      "notes": "input cursor (matches accent)"
    },
    "scrim": {
      "light": "#12151c",
      "dark": "#040508",
      "notes": "overlay scrim ink; CSS emits rgba (light 0.42, dark 0.58)"
    },
    "destructive": {
      "light": "#78001d",
      "dark": "#ffb2b4",
      "notes": "irreversible actions — always the higher-contrast of the destructive/accent pair; never status red, never brand"
    }
  },
  "scrimAlpha": {
    "light": 0.42,
    "dark": 0.58
  },
  "syntax": {
    "syn-keyword": {
      "light": "#531bb7",
      "dark": "#b4a8ff",
      "modus": "magenta-cooler"
    },
    "syn-string": {
      "light": "#2c3bc1",
      "dark": "#88a4ff",
      "modus": "blue-warmer (AA floor 6.63:1 on the cool Sheet ground)"
    },
    "syn-number": {
      "light": "#0100a3",
      "dark": "#c2d6ff",
      "modus": "blue-cooler (constant slot)"
    },
    "syn-function": {
      "light": "#79194b",
      "dark": "#ff9ac5",
      "modus": "magenta"
    },
    "syn-builtin": {
      "light": "#920878",
      "dark": "#fd74d9",
      "modus": "magenta-warmer"
    },
    "syn-type": {
      "light": "#0a6463",
      "dark": "#0fabaa",
      "modus": "cyan-cooler (re-solved; AA floor — the re-tuned grounds leave AAA out of reach at this hue)"
    },
    "syn-variable": {
      "light": "#005e8a",
      "dark": "#00a3ee",
      "modus": "cyan"
    },
    "syn-comment": {
      "light": "#5b5b5a",
      "dark": "#979796",
      "style": "italic",
      "modus": "fg-dim"
    },
    "syn-docstring": {
      "light": "#274d43",
      "dark": "#7ebdaa",
      "modus": "green-faint (Operandi) / cyan-faint (Vivendi)"
    }
  },
  "status": {
