{
  "meta": {
    "name": "Monochrome",
    "slug": "mono",
    "blurb": "neutral grayscale — interaction reads as inverted ink fills and weight, the maker's mark is the one pure black/white, status greys into a severity ladder (glyph + word carry the meaning)",
    "modes": {
      "light": "Print — ink on paper",
      "dark": "Negative — the developed plate"
    }
  },
  "palette": {
    "bg": {
      "light": "#f8f8f8",
      "dark": "#0f0f0f",
      "ansi": "unspecified-bg",
      "notes": "neutral near-white / near-black, never pure"
    },
    "bg-subtle": {
      "light": "#f1f1f1",
      "dark": "#171717",
      "x256": {
        "light": "color-255",
        "dark": "color-234"
      },
      "notes": "code fills, zebra"
    },
    "surface": {
      "light": "#ebebeb",
      "dark": "#1f1f1f",
      "x256": {
        "light": "color-254",
        "dark": "color-235"
      },
      "notes": "card / panel fill"
    },
    "surface-raised": {
      "light": "#fdfdfd",
      "dark": "#2a2a2a",
      "x256": {
        "dark": "color-237"
      },
      "notes": "plates, modals, dropdowns"
    },
    "text": {
      "light": "#2c2c2c",
      "dark": "#d4d4d4",
      "ansi": "unspecified-fg",
      "notes": "body (AAA)"
    },
    "text-muted": {
      "light": "#646464",
      "dark": "#8a8a8a",
      "notes": "meta (AA)"
    },
    "text-heading": {
      "light": "#1c1c1c",
      "dark": "#eaeaea",
      "notes": "titles (AAA)"
    },
    "text-faint": {
      "light": "#8e8e8e",
      "dark": "#616161",
      "notes": "decoration only"
    },
    "accent": {
      "light": "#1a1a1a",
      "dark": "#f1f1f1",
      "ansi": "bright-yellow",
      "notes": "the interactive ink — links and controls render as inverted fills; ANSI 11 stays the accent"
    },
    "accent-hover": {
      "light": "#000000",
      "dark": "#ffffff",
      "notes": ":hover / :active — the fill lifts one step"
    },
    "brand": {
      "light": "#000000",
      "dark": "#ffffff",
      "notes": "the datum mark is the one PURE black / white in the theme"
    },
    "contour": {
      "light": "#525252",
      "dark": "#a5a5a5",
      "notes": "structural linework, mid-gray"
    },
    "border": {
      "light": "#d7d7d7",
      "dark": "#2a2a2a",
      "notes": "default 1px hairline"
    },
    "border-strong": {
      "light": "#afafaf",
      "dark": "#474747",
      "notes": "table heads, field hover"
    },
    "decorator": {
      "light": "#979797",
      "dark": "#595959",
      "notes": "graticule / dashed rules"
    },
    "accent-subtle": {
      "light": "#ededed",
      "dark": "#191919",
      "notes": "solid tint = accent ramp step 1"
    },
    "selection-bg": {
      "light": "#dcdcdc",
      "dark": "#272727",
      "notes": "text selection"
    },
    "cursor": {
      "light": "#1a1a1a",
      "dark": "#f1f1f1",
      "notes": "input cursor (matches accent)"
    },
    "scrim": {
      "light": "#12151c",
      "dark": "#040508",
      "notes": "overlay scrim ink; CSS emits rgba (light 0.42, dark 0.58)"
    },
    "destructive": {
      "light": "#060606",
      "dark": "#fafafa",
      "notes": "irreversible actions — the darkest step in light, nearest-white in dark; always above the accent in contrast"
    }
  },
  "scrimAlpha": {
    "light": 0.42,
    "dark": 0.58
  },
  "syntax": {
    "syn-keyword": {
      "light": "#111111",
      "dark": "#f7f7f7",
      "weight": 700,
      "gray": "near-ink, bold"
    },
    "syn-string": {
      "light": "#444444",
      "dark": "#b4b4b4",
      "gray": "step 2"
    },
    "syn-number": {
      "light": "#565656",
      "dark": "#9b9b9b",
      "gray": "step 3",
      "weight": 700
    },
    "syn-function": {
      "light": "#2c2c2c",
      "dark": "#d6d6d6",
      "weight": 700,
      "gray": "near-ink, bold"
    },
    "syn-builtin": {
      "light": "#444444",
      "dark": "#b4b4b4",
      "style": "italic",
      "gray": "step 3, italic"
    },
    "syn-type": {
      "light": "#2c2c2c",
      "dark": "#d6d6d6",
      "gray": "step 1"
    },
    "syn-variable": {
      "light": "#565656",
      "dark": "#9b9b9b",
      "gray": "step 4"
    },
    "syn-comment": {
      "light": "#686868",
      "dark": "#858585",
      "style": "italic",
      "gray": "faint, italic"
    },
    "syn-docstring": {
      "light": "#565656",
      "dark": "#9b9b9b",
      "style": "italic",
      "gray": "step 5, italic"
    }
  },
  "status": {
    "status-err": {
      "light": "#111111",
      "dark": "#f7f7f7",
      "ansi": "red",
      "notes": "grayscale severity ladder — err darkest/lightest, then warn, ok, info; glyph + word carry the meaning"
    },
    "status-warn": {
      "light": "#333333",
      "dark": "#d1d1d1",
      "ansi": "yellow",
      "notes": "grayscale severity ladder — err darkest/lightest, then warn, ok, info; glyph + word carry the meaning"
    },
    "status-ok": {
      "light": "#525252",
      "dark": "#a5a5a5",
      "ansi": "green",
      "notes": "grayscale severity ladder — err darkest/lightest, then warn, ok, info; glyph + word carry the meaning"
    },
    "status-info": {
      "light": "#696969",
      "dark": "#868686",
      "ansi": "blue",
      "notes": "grayscale severity ladder — err darkest/lightest, then warn, ok, info; glyph + word carry the meaning"
    }
  },
